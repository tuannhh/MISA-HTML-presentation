# MISA Presentation — mẫu biến môi trường. Sao chép thành .env rồi điền giá trị thật.
# KHÔNG commit file .env (đã có trong .gitignore).

NODE_ENV=production
PORT=3000
# Cổng mở ra máy chủ (docker-compose map APP_PORT → 3000 trong container)
APP_PORT=8080
# Địa chỉ người dùng truy cập (dùng kiểm tra Origin chống CSRF) — khớp APP_PORT hoặc domain thật
APP_BASE_URL=http://localhost:8080
# Số proxy tin cậy phía trước (0 nếu truy cập trực tiếp, 1 nếu sau Nginx/Traefik)
TRUST_PROXY=0
# Cổng Nginx khi chạy `docker compose --profile proxy up -d` (cấu hình: deploy/nginx/default.conf).
# Khi dùng proxy: TRUST_PROXY=1, APP_BASE_URL = địa chỉ qua proxy.
PROXY_PORT=80
# Chỉ cho truy cập từ mạng MISA: IP/dải IP được phép (DevOps điền). Để trống = không giới hạn (log cảnh báo ở production).
# Phân tách dấu phẩy hoặc khoảng trắng; nhận IP đơn, CIDR, khoảng a-b; IPv4 + IPv6. Mục sai → ứng dụng không khởi động.
# Ví dụ: IP_ALLOWLIST=203.0.113.0/24,198.51.100.7,192.0.2.10-192.0.2.20
# Ứng dụng đọc IP từ kết nối, sau proxy thì từ X-Forwarded-For → TRUST_PROXY phải ĐÚNG số lớp proxy (đặt dư = bị giả IP).
# /api/health* luôn mở cho healthcheck.
IP_ALLOWLIST=

# Phiên đăng nhập — chuỗi ngẫu nhiên ≥ 32 ký tự: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# true khi chạy HTTPS
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=12

# MySQL (docker-compose tự tạo DB/user theo các biến này)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=misa_presentation
DB_USER=misa_presentation
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Thời gian chờ tối đa cho lượt chuyển thể ghi âm dài / đọc PDF lớn (ms)
GEMINI_MEDIA_TIMEOUT_MS=900000
# Tuỳ chọn: Google API key để tải Google Slides/Docs công khai qua Drive API khi link export bị chặn
GOOGLE_API_KEY=

# Đăng ký: cho phép tự đăng ký, chỉ email thuộc các domain sau (phân tách dấu phẩy; để trống = mọi domain)
SELF_REGISTRATION=true
ALLOWED_EMAIL_DOMAINS=misa.com.vn

# Lưu trữ file (Docker volume)
STORAGE_DIR=/data/storage

# Giới hạn
# Tổng dung lượng mọi tệp nguồn của 1 lần tạo (không giới hạn riêng từng tệp) + số tệp tối đa
MAX_UPLOAD_MB=300
MAX_UPLOAD_FILES=20
MAX_IMAGE_UPLOAD_MB=15
# Video tải lên chèn vào slide: dung lượng 1 video, số video mỗi bài; HTML xuất nhúng video khi tổng ≤ EXPORT_VIDEO_MB
# (sau Nginx: client_max_body_size phải ≥ MAX_VIDEO_MB + vài MB)
MAX_VIDEO_MB=150
MAX_VIDEOS_PER_DECK=10
# Ảnh/video gửi kèm khi tạo bài (luôn được đưa vào bài) — số tệp tối đa mỗi lần tạo
MAX_CREATE_MEDIA=20
EXPORT_VIDEO_MB=200
GENERATION_CONCURRENCY=2
RENDER_CONCURRENCY=2

# Chromium (Docker image đã cài sẵn)
CHROME_PATH=/usr/bin/chromium
CHROME_NO_SANDBOX=true

# Cắt ảnh giao diện phần mềm từ PDF nguồn (cần poppler-utils: pdftoppm; thiếu thì tự bỏ qua)
PDF_UI_SHOTS=true
PDF_UI_SHOT_PAGES=40
PDF_UI_SHOTS_MAX=16
# PDFTOPPM_PATH=pdftoppm

# --- Ảnh minh hoạ AI (Nano Banana 2 Lite) + tìm ảnh Pixabay ---
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# GEMINI_IMAGE_SIZE=1K
# AI_IMAGES=true                 # tắt hẳn tính năng tạo ảnh AI
# AI_IMAGES_PER_DECK=6           # số ảnh AI tự tạo tối đa khi dựng 1 bài
# AI_IMAGES_CONCURRENCY=3
# Khoá Pixabay (https://pixabay.com/api/docs/) — trống thì ô "Tìm ảnh" báo chưa cấu hình.
PIXABAY_API_KEY=
