{
  "name": "misa-presentation",
  "version": "0.1.0",
  "private": true,
  "description": "MISA Presentation — AI tạo bài trình bày HTML có chuyển động từ tài liệu, link hoặc nội dung nhập tay",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env src/server.js",
    "build": "vite build",
    "start": "node src/server.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 test/integration/",
    "render:sample": "node scripts/snap-sample.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  }
}
